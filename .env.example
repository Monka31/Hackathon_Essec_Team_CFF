# Copier ce fichier en .env (qui n'est jamais commité) et remplir les valeurs.
# Les variables déjà définies dans le Terminal sont prioritaires.

# --- Snyk (optionnel si 'snyk auth' a été fait sur la machine) ---
SNYK_TOKEN=
# Slug de l'organisation Snyk (visible dans l'URL app.snyk.io/org/<slug>), si Snyk Code ne la trouve pas
SNYK_ORG=

# --- Snyk API & Web (DAST de l'appli en ligne, ex-Probely) ---
# Clé API : plus.probely.app > Settings > Integrations > API keys. Le domaine doit y être vérifié.
PROBELY_API_KEY=
# PROBELY_API_URL=https://api.probely.com
# Profil de scan (laisser vide pour celui de la cible) ; durée max d'attente en secondes
# PROBELY_SCAN_PROFILE=
DAST_MAX_WAIT_S=1800

# --- Plateforme web ---
# Code demandé dans le formulaire (vide = pas de code). Indispensable une fois en ligne.
PLATFORM_ACCESS_CODE=
# Dépendances : "all" = une ligne par paquet vulnérable, "direct" = regroupé par dépendance directe
NPM_AUDIT_MODE=direct
MAX_PARALLEL_JOBS=2

# --- Supabase Security Advisor (règles d'accès à la base) ---
# Token : supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Référence du projet : visible dans l'URL du dashboard (supabase.com/dashboard/project/<ref>)
SUPABASE_PROJECT_REF=

# --- Semgrep (optionnel) ---
# Jeux de règles du registre, séparés par des virgules
# SEMGREP_CONFIGS=p/default,p/javascript,p/typescript,p/react,p/secrets
# Si le réseau bloque semgrep.dev : dossier de règles locales
# SEMGREP_RULES_DIR=

# --- IA (module 2) ---
# bedrock (défaut), anthropic (API directe, en secours), fake (réponses factices pour l'interface), off
LLM_PROVIDER=bedrock
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5
BEDROCK_MODEL_FAST=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Les identifiants AWS temporaires (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN)
# restent dans le Terminal : ils expirent, inutile de les écrire ici.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY= (non utilisé pour l'instant)
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Nombre max de failles expliquées par analyse (les plus graves d'abord) et appels en parallèle
AI_MAX_FINDINGS=25
AI_PARALLEL=4

# --- GitHub (module 3 : ouverture des PR) ---
# Fine-grained token limité au repo audité : Contents + Pull requests en lecture/écriture
GITHUB_TOKEN=

# --- GitGuardian (optionnel) ---
GITGUARDIAN_API_KEY=
